{
  "name": "studybridge",
  "version": "1.1.1",
  "private": true,
  "description": "Explicit-source desktop study companion with approved phone pairing",
  "author": "StudyBridge",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "electron .",
    "relay": "tsx relay/server.ts",
    "package": "npm run build && electron-builder --win nsis portable --x64",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "katex": "^0.19.1",
    "openai": "^6.0.0",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "electron": "45.3.4",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9",
    "playwright": "^1.55.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "org.studybridge.desktop",
    "productName": "StudyBridge",
    "asar": true,
    "directories": {
      "output": "release/1.1.1"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "StudyBridge-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "StudyBridge-${version}-Portable.${ext}"
    }
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
